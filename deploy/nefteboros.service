[Unit]
Description=nefteboros (Ouroboros server, fork)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/nefteboros
EnvironmentFile=/root/nefteboros/.env
ExecStart=/root/nefteboros/.venv/bin/python /root/nefteboros/server.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/nefteboros/server.log
StandardError=append:/var/log/nefteboros/server.log
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
