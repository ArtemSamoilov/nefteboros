# =============================================================================
# nefteboros — пример конфигурации.
# Скопируй в .env и заполни своими значениями. .env в git не коммитится.
# =============================================================================

# ----- LLM провайдеры -----
# См. ADR-0007 (docs/adr/0007-llm-providers.md): два провайдера для покрытия
# российского рынка моделей и сравнения качества.

# GigaChat (Sber). Получить: https://developers.sber.ru/portal/products/gigachat-api
GIGACHAT_CREDENTIALS=                  # base64(client_id:client_secret) — обязательно
GIGACHAT_SCOPE=GIGACHAT_API_PERS       # GIGACHAT_API_PERS | GIGACHAT_API_CORP | GIGACHAT_API_B2B
GIGACHAT_MODEL=GigaChat-Max            # GigaChat | GigaChat-Pro | GigaChat-Max | GigaChat-Ultra | GigaChat-2-Max
GIGACHAT_BASE_URL=                     # опционально (default: gigachat.devices.sberbank.ru/api/v1)
GIGACHAT_AUTH_URL=                     # опционально (default: ngw.devices.sberbank.ru:9443/api/v2/oauth)
GIGACHAT_VERIFY_SSL=false              # true для prod с установленным CA Минцифры

# HydraGPT (https://hydragpt.ru). Получить: @HydraGPTBot в Telegram, /start → инвайт-код → /token.
# OpenAI-совместимый шлюз к моделям Cloud.ru/JOI: kimi-k2p6, kimi-k2p5, glm-5p1, glm-5,
# deepseek-v4-pro, deepseek-v3p2, deepseek-v3p1, minimax-m2p7, gpt-oss-120b.
HYDRA_API_KEY=                         # формат hydra_<32hex>
HYDRA_BASE_URL=https://hydragpt.ru/v1
HYDRA_DEFAULT_MODEL=kimi-k2p6

# Primary LLM — основная модель для синтеза ответов аналитика
PRIMARY_LLM_PROVIDER=gigachat          # gigachat | hydra
PRIMARY_LLM_MODEL=GigaChat-Max

# Routing LLM — быстрая дешёвая модель для classify_intent в LangGraph subgraph
ROUTING_LLM_PROVIDER=hydra             # обычно отличается от primary (быстрее/дешевле)
ROUTING_LLM_MODEL=glm-5

# ----- Web search -----

BRAVE_API_KEY=                         # https://brave.com/search/api/
BRAVE_RESULTS_PER_QUERY=10
BRAVE_FRESHNESS=pw                     # past day=pd, week=pw, month=pm, year=py

# ----- Embeddings -----

EMBEDDING_MODEL=BAAI/bge-m3            # multilingual, лучший для RU+EN
EMBEDDING_DEVICE=cpu                   # cpu | cuda | mps
EMBEDDING_CACHE_DIR=.embeddings_cache

# ----- Vector store -----

CHROMA_PERSIST_DIR=data/vectorstore
CHROMA_COLLECTION=neftegaz_reports
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.5                # min cosine similarity для ответа на RAG

# ----- Forecast (см. ADR-0012, feature/price-tools) -----

# EIA — фундаментальные ряды и spot-цены (бесплатный ключ на eia.gov/opendata/register.php).
# Используется для Brent/WTI/HH spot (secondary), а также для экзогенов SARIMAX
# (US crude inventories WCESTUS1, gasoline WGTSTUS1, natgas storage NW2_EPG0_SWO_R48_BCF).
EIA_API_KEY=

# Кеш fetcher'ов: TTL CSV в datasets/forecast_cache/<asset>.csv
FORECAST_CACHE_DIR=datasets/forecast_cache
FORECAST_CACHE_TTL_HOURS=24

# Длина истории для обучения моделей и бектеста.
FORECAST_HISTORY_YEARS=5
FORECAST_DEFAULT_HORIZON=3m            # 1m | 3m | 6m | 12m  (>= 18m → отказ + сценарии)

# Бектест: walk-forward с rolling origin (см. ADR-0012)
FORECAST_BACKTEST_TRAIN_WINDOW_YEARS=3.0
FORECAST_BACKTEST_STEP_MONTHS=1

# ----- Telegram bot -----

TELEGRAM_BOT_TOKEN=                    # @BotFather
TELEGRAM_ALLOWED_USER_IDS=             # comma-separated, e.g. 123456,789012. Если пусто — бот отвечает только Артёму
TELEGRAM_ADMIN_CHAT_ID=                # для уведомлений об ошибках

# ----- App / runtime -----

APP_ENV=dev                            # dev | prod
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ----- Ouroboros core (унаследовано из upstream, см. docs/upstream/) -----

# Большая часть настроек Ouroboros — через UI Settings. Здесь только то, что
# нужно нашему агенту:
OUROBOROS_MODEL_LIGHT=                 # для safety-чеков, опционально
OUROBOROS_DATA_DIR=                    # default ~/.local/share/Ouroboros

# Auto-enable extension-skill tools в initial schemas агента (см. ADR-0017).
# Формат: skill_name:short_tool_name[,…]
# Без этого extension-tool появляется только после list_available_tools +
# enable_tools (2 round'а discovery). С этим — сразу в active tools на первом
# ответе агента, LLM видит description и выбирает на доменных запросах.
OUROBOROS_AUTO_ENABLE_SKILLS=neftegaz_analyst:analyst_query
