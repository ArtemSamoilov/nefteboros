# =============================================================================
# nefteboros — пример конфигурации.
# Скопируй в .env и заполни своими значениями. .env в git не коммитится.
# =============================================================================

# ----- LLM провайдеры -----
# См. ADR-0007 (docs/adr/0007-llm-providers.md): два провайдера для покрытия
# российского рынка моделей и сравнения качества.

# GigaChat (Sber). Получить: https://developers.sber.ru/portal/products/gigachat-api
GIGACHAT_CREDENTIALS=                  # base64(client_id:client_secret) — обязательно
GIGACHAT_SCOPE=GIGACHAT_API_PERS       # GIGACHAT_API_PERS | GIGACHAT_API_CORP | GIGACHAT_API_B2B
GIGACHAT_MODEL=GigaChat-Max            # GigaChat | GigaChat-Pro | GigaChat-Max | GigaChat-Ultra | GigaChat-2-Max
GIGACHAT_BASE_URL=                     # опционально (default: gigachat.devices.sberbank.ru/api/v1)
GIGACHAT_AUTH_URL=                     # опционально (default: ngw.devices.sberbank.ru:9443/api/v2/oauth)
GIGACHAT_VERIFY_SSL=false              # true для prod с установленным CA Минцифры

# HydraGPT (https://hydragpt.ru). Получить: @HydraGPTBot в Telegram, /start → инвайт-код → /token.
# OpenAI-совместимый шлюз к моделям Cloud.ru/JOI: kimi-k2p6, kimi-k2p5, glm-5p1, glm-5,
# deepseek-v4-pro, deepseek-v3p2, deepseek-v3p1, minimax-m2p7, gpt-oss-120b.
HYDRA_API_KEY=                         # формат hydra_<32hex>
HYDRA_BASE_URL=https://hydragpt.ru/v1
HYDRA_DEFAULT_MODEL=kimi-k2p6

# ouroboros LLMClient использует префикс `openai-compatible::` для Hydra
# (см. synthesize._call_llm: OUROBOROS_MODEL=openai-compatible::kimi-k2p6).
# Резолвится через `OPENAI_COMPATIBLE_*` env, НЕ через `HYDRA_*` —
# дублируем ключ/URL ниже, иначе synthesize упадёт с
# "OpenAIError: Missing credentials".
OPENAI_COMPATIBLE_API_KEY=             # = HYDRA_API_KEY
OPENAI_COMPATIBLE_BASE_URL=            # = HYDRA_BASE_URL

# AiTunnel (https://api.aitunnel.ru) — secondary LLM provider, fallback при
# отказе Hydra (2026-05-11 prod hit: Hydra под Fireworks suspended, без этого
# fallback chain прерывался на "All models are down"). OpenAI-совместимый
# шлюз с тем же набором моделей: kimi-k2.6, glm-5, deepseek-v4-pro, etc.
# Используется через префикс `aitunnel::<model>` (см. ouroboros/llm.py
# _resolve_remote_target). Можно задать как primary OUROBOROS_MODEL или как
# OUROBOROS_MODEL_LIGHT для consolidator/safety-чеков.
AITUNNEL_API_KEY=                      # формат sk-aitunnel-<token>
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1

# Primary LLM — основная модель агента (main loop, синтез ответов, tool calls).
# Решено: Kimi-k2p6 (Hydra) — крепкая instruction-following + большой context (256K),
# подходит под нагрузку production. Tools исполняются под Kimi.
PRIMARY_LLM_PROVIDER=hydra             # gigachat | hydra
PRIMARY_LLM_MODEL=kimi-k2p6

# Routing/light LLM — для лёгких задач (классификация intent в analyst_graph,
# disambiguate ambiguous queries, summarize). Внутренний LLM-узел графа,
# не main loop.
ROUTING_LLM_PROVIDER=gigachat          # gigachat для лёгких задач
ROUTING_LLM_MODEL=GigaChat-Max

# ----- Web search -----

BRAVE_API_KEY=                         # https://brave.com/search/api/
BRAVE_RESULTS_PER_QUERY=10
BRAVE_FRESHNESS=pw                     # past day=pd, week=pw, month=pm, year=py

# ----- Embeddings -----

EMBEDDING_MODEL=BAAI/bge-m3            # multilingual, лучший для RU+EN
EMBEDDING_DEVICE=cpu                   # cpu | cuda | mps
EMBEDDING_CACHE_DIR=.embeddings_cache

# ----- Vector store -----

CHROMA_PERSIST_DIR=data/vectorstore
CHROMA_COLLECTION=neftegaz_reports
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.5                # min cosine similarity для ответа на RAG

# Production RAG-коллекция в data/vectorstore/. Default в `nefteboros/rag/store.py`
# теперь смотрит на `nefteboros_corpus_v2_heading` (heading prefix v2 — production
# default из ADR-0018, 802 чанка, chunk_hit@5 = 0.779). Эта env var — override
# для тестов другой коллекции (например, при experiments).
NEFTEBOROS_RAG_COLLECTION=nefteboros_corpus_v2_heading

# ----- Forecast (см. ADR-0012, feature/price-tools) -----

# EIA — фундаментальные ряды и spot-цены (бесплатный ключ на eia.gov/opendata/register.php).
# Используется для Brent/WTI/HH spot (secondary), а также для экзогенов SARIMAX
# (US crude inventories WCESTUS1, gasoline WGTSTUS1, natgas storage NW2_EPG0_SWO_R48_BCF).
EIA_API_KEY=

# Кеш fetcher'ов: TTL CSV в datasets/forecast_cache/<asset>.csv
FORECAST_CACHE_DIR=datasets/forecast_cache
FORECAST_CACHE_TTL_HOURS=24

# Длина истории для обучения моделей и бектеста.
FORECAST_HISTORY_YEARS=5
FORECAST_DEFAULT_HORIZON=3m            # 1m | 3m | 6m | 12m  (>= 18m → отказ + сценарии)

# Бектест: walk-forward с rolling origin (см. ADR-0012)
FORECAST_BACKTEST_TRAIN_WINDOW_YEARS=3.0
FORECAST_BACKTEST_STEP_MONTHS=1

# ----- Telegram bot -----

TELEGRAM_BOT_TOKEN=                    # @BotFather
TELEGRAM_ALLOWED_USER_IDS=             # comma-separated, e.g. 123456,789012. Если пусто — бот отвечает только Артёму
TELEGRAM_ADMIN_CHAT_ID=                # для уведомлений об ошибках

# ----- App / runtime -----

APP_ENV=dev                            # dev | prod
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ----- Observability — Langfuse (см. ADR-0024) -----
# Серверные трейсы всех узлов LangGraph + cost/latency dashboard.
# В demo-режиме (без ключей) — JSON-trace в metrics/runs/<ts>/trace.jsonl
# работает независимо как backup.
#
# Получить ключи: https://cloud.langfuse.com → settings → API keys.
# Free tier: 50k observations/мес — с гигантским запасом для смока + e2e.
#
# При LANGFUSE_ENABLED=false (или отсутствии ключей) Langfuse SDK не
# импортируется, работает только JSONL writer. Если ключ задан, но Langfuse
# Cloud недоступен (RKN, network) — graceful warning в logger, флаг форсится
# в false на уровне процесса, граф продолжает работать. Ошибки никогда не
# попадают в финальный ответ агента / UI пользователя — только в logging.

LANGFUSE_ENABLED=true                  # false для demo/CI без ключей
LANGFUSE_PUBLIC_KEY=                   # pk-lf-...
LANGFUSE_SECRET_KEY=                   # sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Координация с Track D (e2e baseline-run): D2 выставляет OBSERVABILITY_RUN_DIR
# перед запуском, чтобы trace.jsonl лёг в ту же папку что e2e-baseline.json.
# Если не выставлен — генерируется metrics/runs/<utcnow_iso>/.
OBSERVABILITY_RUN_DIR=                 # absolute path, опционально

# ----- Ouroboros core (унаследовано из upstream, см. docs/upstream/) -----

# Большая часть настроек Ouroboros — через UI Settings. Здесь только то, что
# нужно нашему агенту:
OUROBOROS_MODEL_LIGHT=                 # для safety-чеков, опционально
OUROBOROS_DATA_DIR=                    # default ~/.local/share/Ouroboros

# Auto-enable extension-skill tools в initial schemas агента (см. ADR-0017).
# Формат: skill_name:short_tool_name[,…]
# Без этого extension-tool появляется только после list_available_tools +
# enable_tools (2 round'а discovery). С этим — сразу в active tools на первом
# ответе агента, LLM видит description и выбирает на доменных запросах.
OUROBOROS_AUTO_ENABLE_SKILLS=neftegaz_analyst:analyst_query,neftegaz_analyst:rag_search

# Глобальный default max_tokens (output cap) для всех LLM-вызовов в проекте.
# 256_000 — потолок Kimi-k2p6, чтобы artifact-ные limits типа 2048/4096/8192 не
# обрезали reasoning-style output (Kimi/GLM тратят значительную долю output на
# скрытый delta.reasoning_content). Stream-mode для openai-compatible (chat_async
# + sync chat()) разблокирует Hydra cap 4096 для non-stream путей. См. ADR-0021.
# Провайдеры с собственным жёстким cap'ом (Anthropic ~16K, GigaChat ~16K) сами
# вернут 400 / clamp при превышении — для них переопределять параметром в вызове.
OUROBOROS_MAX_OUTPUT_TOKENS=256000

# Phase 4 skill review pipeline — модели для триметодельного review.
# Через Hydra работают только non-reasoning модели — у Kimi/GLM CoT стиль
# ответа, review parser ожидает чистый JSON. DeepSeek/MiniMax/gpt-oss отдают
# валидный JSON-array согласно output contract. Stream-режим в chat_async
# разблокирован для openai-compatible (см. ADR-0019).
OUROBOROS_REVIEW_MODELS=openai-compatible::deepseek-v4-pro,openai-compatible::minimax-m2p7,openai-compatible::gpt-oss-120b
OUROBOROS_SCOPE_REVIEW_MODEL=openai-compatible::deepseek-v4-pro
