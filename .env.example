# =============================================================================
# nefteboros — пример конфигурации.
# Скопируй в .env и заполни своими значениями. .env в git не коммитится.
# =============================================================================

# ----- LLM провайдеры -----

# GigaChat (приоритетный для Сбера, см. ADR-0001)
# Получить: https://developers.sber.ru/portal/products/gigachat-api
GIGACHAT_CREDENTIALS=                  # base64(client_id:client_secret)
GIGACHAT_SCOPE=GIGACHAT_API_PERS       # GIGACHAT_API_PERS | GIGACHAT_API_CORP | GIGACHAT_API_B2B
GIGACHAT_MODEL=GigaChat-Max            # GigaChat-Lite | GigaChat-Pro | GigaChat-Max | GigaChat-Ultra
GIGACHAT_VERIFY_SSL=true               # false если возникают проблемы с CA Минцифры

# Cloud.ru Foundation Models (kimi-k2p6, glm-5p1, deepseek-v4-pro и др.)
# OpenAI-compatible API
CLOUDRU_API_KEY=
CLOUDRU_BASE_URL=                      # точный URL даст Артём (см. issue #1)
CLOUDRU_DEFAULT_MODEL=kimi-k2p6

# Какую модель использовать как primary в графе по умолчанию
PRIMARY_LLM_PROVIDER=gigachat          # gigachat | cloudru
PRIMARY_LLM_MODEL=GigaChat-Max

# Модель для классификации (быстрая и дешёвая) — может отличаться от primary
ROUTING_LLM_PROVIDER=cloudru
ROUTING_LLM_MODEL=glm-5

# ----- Web search -----

BRAVE_API_KEY=                         # https://brave.com/search/api/
BRAVE_RESULTS_PER_QUERY=10
BRAVE_FRESHNESS=pw                     # past day=pd, week=pw, month=pm, year=py

# ----- Embeddings -----

EMBEDDING_MODEL=BAAI/bge-m3            # multilingual, лучший для RU+EN
EMBEDDING_DEVICE=cpu                   # cpu | cuda | mps
EMBEDDING_CACHE_DIR=.embeddings_cache

# ----- Vector store -----

CHROMA_PERSIST_DIR=data/vectorstore
CHROMA_COLLECTION=neftegaz_reports
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.5                # min cosine similarity для ответа на RAG

# ----- Forecast -----

FORECAST_HISTORY_CSV=datasets/forecast_history.csv
FORECAST_DEFAULT_HORIZON=3             # months
YFINANCE_TICKER=BZ=F                   # Brent Crude futures

# ----- Telegram bot -----

TELEGRAM_BOT_TOKEN=                    # @BotFather
TELEGRAM_ALLOWED_USER_IDS=             # comma-separated, e.g. 123456,789012. Если пусто — бот отвечает только Артёму
TELEGRAM_ADMIN_CHAT_ID=                # для уведомлений об ошибках

# ----- App / runtime -----

APP_ENV=dev                            # dev | prod
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ----- Ouroboros core (унаследовано из upstream, см. docs/upstream/) -----

# Большая часть настроек Ouroboros — через UI Settings. Здесь только то, что
# нужно нашему агенту:
OUROBOROS_MODEL_LIGHT=                 # для safety-чеков, опционально
OUROBOROS_DATA_DIR=                    # default ~/.local/share/Ouroboros
