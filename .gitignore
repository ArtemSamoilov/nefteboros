# Accidentally vendored site-packages fragments — guard against recurrence of the
# pre-rc.7 "dump site-packages into the source tree" bug (see Version History
# entry for 4.50.0-rc.7 for the purge rationale). Anchored to repo root so a
# legitimate same-named subfolder deeper in the tree is not accidentally hidden.
/Python
/Python.framework/
/webview/
/jsonschema/
/jsonschema_specifications/
/certifi/

# ============================================================================
# nefteboros-specific (см. docs/changelog/2026-05-04-init-skeleton.md)
# ============================================================================

# Claude Code / агент-инструменты — рабочие данные не должны попадать в репо
.claude/
.cursor-tutor/

# RAG-данные — корпус и векторстор больше git'а; список PDF — в data/metadata/
/data/corpus/*
!/data/corpus/.gitkeep
/data/vectorstore/*
!/data/vectorstore/.gitkeep
/data/markdown/*
!/data/markdown/.gitkeep

# Ouroboros runtime drive (state, memory, logs) — создаётся при первом запуске
/data/ouroboros/

# Кеш эмбеддингов
.embeddings_cache/

# Eval runs — артефакты прогонов хранятся локально, в репо только сводный dashboard
/metrics/runs/*
!/metrics/runs/.gitkeep

# Локальные расширения датасетов — НЕ коммитим *.local.jsonl
/datasets/*.local.*

# Forecast runtime cache (TTL CSV-cache fetcher'ов; см. ADR-0012)
/datasets/forecast_cache/*
!/datasets/forecast_cache/.gitkeep

# Telegram bot session files
*.session
*.session-journal

# Streamlit
.streamlit/secrets.toml

# Jupyter
.ipynb_checkpoints/
